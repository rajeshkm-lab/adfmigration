{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adfdevprojectenvironment"
		},
		"LS_STORAGE_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_STORAGE'"
		},
		"LS_OUTPUT_PAR_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_OUTPUT_PAR'"
		},
		"LS_STORAGE_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsscheduleeventtrigger.dfs.core.windows.net/"
		},
		"LS_OUTPUT_PAR_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://opscheduleeventtrigger.dfs.core.windows.net/"
		},
		"EVENT_TRIGGER_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/d1c92860-e381-4dc4-8277-548b37199229/resourceGroups/adfresourcegroup/providers/Microsoft.Storage/storageAccounts/adlsscheduleeventtrigger"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adfdevprojectenvironment_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_STORAGE_accountKey": {
						"value": "[parameters('LS_STORAGE_accountKey')]"
					},
					"LS_OUTPUT_PAR_accountKey": {
						"value": "[parameters('LS_OUTPUT_PAR_accountKey')]"
					},
					"LS_STORAGE_properties_typeProperties_url": {
						"value": "[parameters('LS_STORAGE_properties_typeProperties_url')]"
					},
					"LS_OUTPUT_PAR_properties_typeProperties_url": {
						"value": "[parameters('LS_OUTPUT_PAR_properties_typeProperties_url')]"
					},
					"EVENT_TRIGGER_properties_typeProperties_scope": {
						"value": "[parameters('EVENT_TRIGGER_properties_typeProperties_scope')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}